<Window x:Class="Faceless.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Faceless — удаление авторов из метаданных"
        Height="620" Width="700"
        MinHeight="480" MinWidth="500"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки очистки -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#6B7280"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль чекбокса -->
        <Style x:Key="ToggleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="#4B5563"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Check"
                                           Text="✓"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#4B3F72"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4B3F72"/>
                                <Setter Property="Foreground" Value="#6B5F8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Faceless"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#A78BFA"/>
            <TextBlock Text="Удаляет информацию об авторах из метаданных файлов"
                       FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Панель настроек вывода -->
        <Border Grid.Row="1"
                Background="#13131F"
                BorderBrush="#374151"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка: папка сохранения -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Сохранять в:"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Border Grid.Column="1"
                            Background="#1E1E2E"
                            BorderBrush="#374151"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,5">
                        <TextBlock x:Name="OutputPathLabel"
                                   Text="Рядом с оригиналом"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="2"
                            Content="Выбрать..."
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            Padding="10,5"
                            Click="ChooseOutputFolder_Click"/>

                    <Button Grid.Column="3"
                            Content="✕"
                            x:Name="ClearOutputFolderButton"
                            Style="{StaticResource GhostButton}"
                            Margin="4,0,0,0"
                            Padding="8,5"
                            Visibility="Collapsed"
                            ToolTip="Сбросить — сохранять рядом с оригиналом"
                            Click="ClearOutputFolder_Click"/>
                </Grid>

                <!-- Строка: чекбокс суффикса -->
                <CheckBox Grid.Row="1"
                          x:Name="AddSuffixCheckBox"
                          Content="Добавлять суффикс _faceless к имени файла"
                          Style="{StaticResource ToggleCheckBox}"
                          IsChecked="True"
                          Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Зона Drag'n'Drop -->
        <Border Grid.Row="2"
                x:Name="DropZone"
                Background="#13131F"
                BorderBrush="#374151"
                BorderThickness="2"
                CornerRadius="10"
                AllowDrop="True"
                Drop="DropZone_Drop"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                MouseLeftButtonUp="DropZone_Click">
            <Grid>

            <!-- Placeholder когда нет файлов -->
            <Grid x:Name="PlaceholderGrid" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="⬇" FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="#4B5563"/>
                    <TextBlock Text="Перетащите файлы сюда"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4"/>
                    <TextBlock Text="или нажмите для выбора"
                               FontSize="12" Foreground="#4B5563"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="DOCX · XLSX · PPTX · PDF · JPEG · PNG · TIFF"
                               FontSize="11" Foreground="#374151"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Список файлов -->
            <Grid x:Name="FileListGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="FileListBox"
                         Grid.Row="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="12,12,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource FileItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E2E" CornerRadius="6"
                                    Margin="0,2" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка типа файла -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- Имя и статус -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13"
                                                   Foreground="#E5E7EB"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Foreground="{Binding StatusColor}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Индикатор -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusIcon}"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Ссылка добавить ещё -->
                <TextBlock Grid.Row="1"
                           Text="+ Добавить ещё файлы"
                           FontSize="11" Foreground="#6B7280"
                           Cursor="Hand"
                           Margin="14,6,0,10"
                           MouseLeftButtonUp="AddMore_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            </Grid>
        </Border>

        <!-- Прогресс-бар -->
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="3"
                     Height="4"
                     Margin="0,12,0,0"
                     Background="#374151"
                     Foreground="#7C3AED"
                     BorderThickness="0"
                     Visibility="Collapsed"
                     Minimum="0" Maximum="100"/>

        <!-- Кнопки -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Счётчик -->
            <TextBlock x:Name="CountLabel"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="12"
                       Text="Файлов не выбрано"/>

            <!-- Очистить -->
            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Content="Очистить"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="ClearButton_Click"/>

            <!-- Обработать -->
            <Button x:Name="ProcessButton"
                    Grid.Column="2"
                    Content="Удалить авторов"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Click="ProcessButton_Click"/>
        </Grid>
    </Grid>
</Window>
